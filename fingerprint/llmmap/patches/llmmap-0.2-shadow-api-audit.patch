+    # len(queries) API calls (800 at the defaults). Completed prompt
+    # configurations are appended to a checkpoint file and skipped on a rerun, so
+    # a rate limit or a dropped connection does not restart the whole model.
+    checkpoint_file = os.path.join(
+        checkpoint_dir, f"checkpoint_{llm.llm_name.replace('/', '_')}_{pool}.jsonl"
+    )
+    os.makedirs(os.path.dirname(os.path.abspath(checkpoint_file)), exist_ok=True)
+
+    entries, done = [], set()
